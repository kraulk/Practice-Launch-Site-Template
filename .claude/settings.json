{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run check)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run verify)",
      "Bash(npm run launch-check)",
      "Bash(npx astro check)",
      "Bash(npx astro info)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__astro-docs__search_astro_docs"
    ],
    "ask": ["Bash(npm install:*)", "Bash(npm uninstall:*)", "Bash(npx wrangler:*)", "Bash(git push:*)"],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.production)", "Bash(npm publish:*)"]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["astro-docs"]
}
