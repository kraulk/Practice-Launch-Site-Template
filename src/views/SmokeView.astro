---
/**
 * Phase 1 placeholder for the home page. Exercises the layout, booking CTA, and
 * prose styles with real seed content. Replaced by HomeView in roadmap Phase 2.
 */
import { render } from "astro:content";
import { getPage, getSingleton } from "@/lib/content";
import Base from "@/layouts/Base.astro";
import BookingCta from "@/components/BookingCta.astro";
import Prose from "@/components/Prose.astro";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const home = await getSingleton("home", locale);
const about = await getPage("about", locale);
const { Content } = await render(about);
---

<Base locale={locale} description={home.data.seoDescription}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl leading-tight font-semibold text-ink sm:text-5xl">
      {home.data.hero.heading}
    </h1>
    {home.data.hero.subheading && <p class="mt-4 text-lg text-ink-muted">{home.data.hero.subheading}</p>}
    <BookingCta locale={locale} class="mt-8" />
    <Prose class="mt-12">
      <h2>{about.data.heading ?? about.data.title}</h2>
      <Content />
    </Prose>
  </div>
</Base>
