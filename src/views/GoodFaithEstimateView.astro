---
/** Standalone Good Faith Estimate page, used only when `features.fees` is off. */
import { t } from "@/i18n";
import Base from "@/layouts/Base.astro";
import GoodFaithEstimate from "@/components/GoodFaithEstimate.astro";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const gfe = t(locale).goodFaithEstimate;
---

<Base locale={locale} title={t(locale).nav.goodFaithEstimate} description={gfe.metaDescription}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <GoodFaithEstimate locale={locale} level={1} />
  </div>
</Base>
