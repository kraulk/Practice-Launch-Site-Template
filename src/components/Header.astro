---
/**
 * Site header: wordmark (logo or practice name), main nav from the route
 * registry, and the booking button.
 *
 * Mobile menu: without JavaScript the nav is simply shown, stacked. The inline
 * script reveals the Menu button and collapses the nav behind it. From the `lg`
 * breakpoint up the nav is always visible and the button is hidden: the
 * wordmark and booking button share the top row, and the nav sits below so
 * long practice names and all seven sections fit without crowding.
 */
import { t } from "@/i18n";
import { getSettings } from "@/lib/content";
import { href, isCurrent, mainNav } from "@/lib/routes";
import BookingCta from "@/components/BookingCta.astro";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const ui = t(locale);
const settings = await getSettings();
const nav = mainNav(settings.features, locale);
const homeHref = href("", locale);
const pathname = Astro.url.pathname;
const logo = settings.logo?.src ? settings.logo : undefined;
---

<header class="group border-b border-line bg-surface" data-site-header>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6 lg:grid lg:grid-cols-[1fr_auto] lg:gap-y-1 lg:pt-4 lg:pb-1">
    <a
      href={homeHref}
      class="inline-flex min-h-11 min-w-0 flex-1 items-center font-display text-lg leading-tight font-semibold text-ink no-underline sm:text-xl"
      aria-current={pathname === homeHref ? "page" : undefined}
    >
      {logo ? <img src={logo.src} alt={logo.alt} class="h-10 w-auto max-w-56" /> : settings.practiceName}
    </a>

    <button
      type="button"
      class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-card border border-line px-4 font-semibold text-ink lg:hidden"
      aria-controls="site-menu"
      aria-expanded="false"
      data-menu-toggle
      hidden
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path class="group-data-[menu=open]:hidden" d="M3 5h14M3 10h14M3 15h14"></path>
        <path class="hidden group-data-[menu=open]:block" d="M5 5l10 10M15 5 5 15"></path>
      </svg>
      {ui.menu}
    </button>

    <div id="site-menu" class="w-full pb-3 group-data-[menu=closed]:max-lg:hidden lg:contents">
      <nav aria-label={ui.mainNavLabel} class="lg:col-span-2 lg:row-start-2 lg:-mx-3">
        <ul class="flex flex-col lg:flex-row lg:flex-wrap lg:gap-x-1">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(pathname, item.href) ? "page" : undefined}
                class="flex min-h-11 items-center rounded-card px-3 text-ink no-underline decoration-2 underline-offset-8 hover:bg-surface-alt aria-[current=page]:font-semibold aria-[current=page]:underline max-lg:-mx-3"
              >
                {ui.nav[item.key]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <BookingCta locale={locale} compact class="mt-3 lg:col-start-2 lg:row-start-1 lg:mt-0" />
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector("[data-site-header]");
    const button = header?.querySelector("[data-menu-toggle]");
    if (!header || !button) return;
    const set = (open) => {
      header.dataset.menu = open ? "open" : "closed";
      button.setAttribute("aria-expanded", String(open));
    };
    set(false);
    button.hidden = false;
    button.addEventListener("click", () => set(header.dataset.menu !== "open"));
    header.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.dataset.menu === "open") {
        set(false);
        button.focus();
      }
    });
  })();
</script>
